{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && php -r \"foreach (glob('public/build/assets/*.css') as \\$f) file_put_contents(\\$f, str_replace('url(\\\"/build/assets/', 'url(\\\"./', file_get_contents(\\$f)));\"",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "alpinejs": "^3.17.5"
    }
}
