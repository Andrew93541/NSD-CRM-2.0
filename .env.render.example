# ==============================================================================
# NSD CRM 2.0 — Render Free Web Service + TiDB Cloud Starter Environment Template
# ==============================================================================
# IMPORTANT:
# 1. Never commit real secrets or passwords to Git.
# 2. Never set DB_DATABASE=nsd_crm_2 in the demo environment.
# 3. Generate a fresh APP_KEY specifically for the demo service:
#    php artisan key:generate --show
# ==============================================================================

APP_NAME="NSD CRM 2.0 (Demo)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nsd-crm-2-demo.onrender.com
FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

# Log to container stderr so Render captures logs natively without filling ephemeral disk
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# TiDB Cloud Starter (MySQL-compatible serverless cluster on port 4000 with mandatory TLS)
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=nsd_crm_demo
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DB_SSL_VERIFY_SERVER_CERT=true

# Session & Cookie Security (Database-backed sessions survive container restarts)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache & Queue (Database-backed cache; sync queue on single free web container)
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Mail & 2FA Configuration
# Note: Render Free blocks outbound SMTP on ports 25, 465, and 587.
# Use RFC 6238 Authenticator App (TOTP QR / Base32) for 2FA on Render Free,
# or configure an HTTPS-based mail transport.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@nsd-demo.example"
MAIL_FROM_NAME="${APP_NAME}"
AUTH_ENFORCE_MANAGER_2FA=false

# Render Startup Automation (Safe only on isolated demo DB)
RENDER_AUTO_MIGRATE=true
RENDER_AUTO_SEED_DEMO=true

# Synthetic Demo Tenant & Account Provisioning (Leave passwords blank in Git; set in Render Dashboard)
DEMO_COMPANY_CODE=DEMO-NSD
DEMO_COMPANY_NAME="NSD Demo Infrastructure Pvt Ltd"
DEMO_ADMIN_EMAIL=demo.admin@nsd-demo.example
DEMO_ADMIN_PASSWORD=
DEMO_SENIOR_MANAGER_EMAIL=demo.senior@nsd-demo.example
DEMO_SITE_MANAGER_EMAIL=demo.sitemanager@nsd-demo.example
DEMO_MANAGER_PASSWORD=
DEMO_SUPERVISOR_EMAIL=demo.supervisor@nsd-demo.example
DEMO_STAFF_EMAIL=demo.office@nsd-demo.example
DEMO_STAFF_PASSWORD=

